{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Lender application",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "applicationId": { "type": "string", "minLength": 1 },
    "borrowerId": { "type": "string", "minLength": 1 },
    "brokerId": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": [
        "APPLIED",
        "AI_DELIBERATED",
        "UNDERWRITER_APPROVED",
        "FUNDED",
        "CLOSED",
        "REJECTED"
      ]
    },
    "financialSpecs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grossIncomeMinorUnits": { "type": "integer", "minimum": 0 },
        "existingDebtMinorUnits": { "type": "integer", "minimum": 0 },
        "depositMinorUnits": { "type": "integer", "minimum": 0 },
        "requestedTermMonths": { "type": "integer", "minimum": 1, "maximum": 600 }
      },
      "required": [
        "grossIncomeMinorUnits",
        "existingDebtMinorUnits",
        "depositMinorUnits",
        "requestedTermMonths"
      ]
    },
    "propertySpecs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "askingPriceMinorUnits": { "type": "integer", "minimum": 0 },
        "berRating": {
          "type": "string",
          "enum": [
            "A1", "A2", "A3", "B1", "B2", "B3",
            "C1", "C2", "C3", "D1", "D2",
            "E1", "E2", "F", "G", "UNKNOWN"
          ]
        },
        "county": { "type": "string", "minLength": 1 },
        "floorAreaSquareMetres": { "type": "number", "exclusiveMinimum": 0 },
        "bedrooms": { "type": "integer", "minimum": 0 },
        "propertyType": { "type": "string", "minLength": 1 }
      },
      "required": ["askingPriceMinorUnits", "berRating", "county"]
    },
    "aiAssessment": {
      "type": ["object", "null"],
      "properties": {
        "recommendation": {
          "type": "string",
          "enum": ["APPROVE", "CONDITIONALLY_APPROVE", "DECLINE"]
        },
        "valuation": { "type": "object" },
        "affordability": { "type": "object" },
        "creditMemo": { "type": "string" },
        "modelVersion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recommendation", "createdAt"]
    },
    "underwriterApproval": {
      "type": ["object", "null"],
      "properties": {
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "auditHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "required": ["approvedBy", "approvedAt", "auditHash"]
    },
    "underwriterDecision": {
      "type": ["object", "null"],
      "properties": {
        "decision": { "type": "string", "enum": ["REJECTED"] },
        "rejectedBy": { "type": "string", "minLength": 1 },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "rejectionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "required": ["decision", "rejectedBy", "rejectedAt", "rejectionHash"]
    },
    "blockchainTx": {
      "type": ["object", "null"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "CONFIRMED", "FAILED"]
        },
        "auditHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "chainId": { "type": "integer", "minimum": 1 },
        "applicationIdHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "tokenId": { "type": "string", "pattern": "^[0-9]+$" },
        "auditTxHash": {
          "type": ["string", "null"],
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "loanTxHash": {
          "type": ["string", "null"],
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "blockNumber": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": ["status", "auditHash"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["applicationId", "borrowerId", "status", "createdAt"]
}
