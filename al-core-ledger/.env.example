# Copy this file to .env and replace every value marked REPLACE.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID

# Generate a private, persistent secret with: openssl rand -hex 32
BORROWER_HASH_SECRET=replace-me

EVM_RPC_URL=http://127.0.0.1:8545
EVM_CHAIN_ID=31337
# Leave the private key unset when using an unlocked local Hardhat account.
EVM_PRIVATE_KEY=
EVM_SENDER_ADDRESS=
API_SIGNER_ADDRESS=

# Replace both addresses with the output from npm run deploy:localhost.
AUDIT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000001
LOAN_TOKEN_ADDRESS=0x0000000000000000000000000000000000000002
CONTRACT_ARTIFACTS_DIR=./artifacts
EVM_CONFIRMATION_TIMEOUT_SECONDS=120

# Add the exact origins used by the web portal; do not use * with credentials.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
