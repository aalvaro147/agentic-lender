# WEB-24: local Firebase Emulator Suite (npm run dev:emulator).
# "demo-al" is a demo project: it exists only on this computer, needs no real
# Firebase config and never reaches Google. These values are not secrets.
VITE_USE_MOCKS=false
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-al.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-al
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=